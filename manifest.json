{
  "manifest_version": 3,
  "name": "Crunchyroll Volume Boost",
  "version": "1.0.2",
  "description": "A browser extension that extends Crunchyroll's player volume control from 100% to 600%.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": [
        "page-audio.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
